NODE_ENV=development
PORT=5005
# Browser origin(s) of the dashboard, comma separated (exact match, no wildcard)
FRONTEND_ORIGIN=http://localhost:5174

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=security_monitor

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
# Separate Redis DB index so keys never mix with your price-comparison app
REDIS_DB=5

# >= 32 random chars each. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SERVICE_HMAC_SECRET=
# Optional: previous HMAC secret kept during rotation
SERVICE_HMAC_SECRET_PREVIOUS=

# Admin session cookie lifetime (minutes)
JWT_TTL_MIN=15
COOKIE_SECURE=false
LOG_LEVEL=info
