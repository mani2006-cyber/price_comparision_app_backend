# ── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/price_compare

# ── Auth: Access token (short-lived, sent as Authorization: Bearer) ──────
ACCESS_TOKEN_SECRET=replace_this_with_a_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m

# ── Auth: Refresh token (long-lived, HttpOnly cookie, hashed in DB) ──────
# MUST be a DIFFERENT secret from ACCESS_TOKEN_SECRET - if one leaks, the
# other token type must stay safe.
REFRESH_TOKEN_SECRET=replace_this_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Auth: Refresh token cookie settings ───────────────────────────────────
# COOKIE_SECURE should be "true" in production (HTTPS only). Keep "false"
# for local http://localhost development, or the browser will silently
# refuse to store the cookie at all.
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
REFRESH_COOKIE_NAME=refreshToken

BCRYPT_SALT_ROUNDS=10

# ── Cache ────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=600

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# /compare-url has its own, stricter limiter (it's the most scraping-heavy
# endpoint) - used to be hardcoded directly in product.routes.js.
COMPARE_RATE_LIMIT_WINDOW_MS=60000
COMPARE_RATE_LIMIT_MAX=10

# ── CORS ─────────────────────────────────────────────────────────────────
# credentials must be allowed for cookies to be sent cross-origin between
# your frontend (e.g. localhost:5173) and this API (localhost:5000).
CORS_ORIGINS=http://localhost:5173

# ── Compare / similarity matching ───────────────────────────────────────
SIMILARITY_THRESHOLD=0.2
MAX_CROSS_MATCHES=5
# Were bare module-level consts in src/utils/similarity.js - see that
# file's own comments for the regression stories behind each value.
COMPARE_MIN_PRICE_RATIO=0.4
COMPARE_MAX_PRICE_RATIO=2.5
COMPARE_MIN_TITLE_SIMILARITY=0.12

# ── Price refresher job ──────────────────────────────────────────────────
PRICE_REFRESHER_CRON=0 */6 * * *
PRICE_REFRESHER_DELAY_MS=2000

# ── Scraper tuning (shared by every scraper-based adapter) ──────────────
SCRAPER_TIMEOUT_MS=20000
SCRAPER_MAX_SEARCH_RESULTS=8

# amazon.scraper.js's own retry/backoff/circuit-breaker tuning.
AMAZON_SCRAPER_MAX_RETRIES=4
AMAZON_SCRAPER_BASE_DELAY_MS=1000
AMAZON_SCRAPER_MAX_DELAY_MS=15000
AMAZON_SCRAPER_CIRCUIT_FAILURE_THRESHOLD=3
AMAZON_SCRAPER_CIRCUIT_COOLDOWN_MS=300000

# Official-API search result cap - kept separate from
# SCRAPER_MAX_SEARCH_RESULTS since a metered API call has a different
# cost profile than a scrape.
API_MAX_SEARCH_RESULTS=20
RAPIDAPI_TIMEOUT_MS=10000

SSE_HEARTBEAT_MS=25000
PRODUCT_MAX_IMAGES=10

# ── Category browsing ────────────────────────────────────────────────────
CATEGORY_DEFAULT_LIMIT=20
CATEGORY_MAX_LIMIT=50

# ── Provider modes: "scraper" | "api" | "auto" ──────────────────────────
AMAZON_PROVIDER_MODE=auto
FLIPKART_PROVIDER_MODE=auto
MYNTRA_PROVIDER_MODE=scraper
AJIO_PROVIDER_MODE=scraper
LENSKART_PROVIDER_MODE=scraper

# ── Official API credentials ─────────────────────────────────────────────
AMAZON_RAPIDAPI_KEY=replace_with_your_own_rapidapi_key
AMAZON_RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
AMAZON_API_COUNTRY=IN

FLIPKART_RAPIDAPI_KEY=replace_with_your_own_rapidapi_key
FLIPKART_RAPIDAPI_HOST=real-time-flipkart-data2.p.rapidapi.com

# ── AI-generated comparison summary (optional, OpenRouter) ──────────────
# If unset, POST /compare-url's result.aiSummary is simply null - never a
# hard dependency. Get a free key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MAX_TOKENS=200
OPENROUTER_TEMPERATURE=0.4