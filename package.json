{
    "name": "price-compare-backend",
    "version": "1.0.0",
    "description": "Production backend for the Price Comparison platform - aggregates and compares product prices across Amazon, Flipkart, Myntra, Ajio, Lenskart and other providers.",
    "main": "server.js",
    "type": "commonjs",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "test": "cross-env NODE_ENV=test jest --runInBand",
        "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch"
    },
    "dependencies": {
        "axios": "^1.7.9",
        "bcryptjs": "^2.4.3",
        "cheerio": "^1.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.4.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.9.0",
        "node-cache": "^5.1.2",
        "node-cron": "^3.0.3"
    },
    "devDependencies": {
        "cross-env": "^7.0.3",
        "jest": "^29.7.0",
        "supertest": "^7.0.0"
    }
}